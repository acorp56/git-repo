{
  "name": "@pavhelp/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "migrate": "tsx --env-file-if-exists=.env src/migrate.ts",
    "seed": "tsx --env-file-if-exists=.env src/seed.ts",
    "test": "vitest run",
    "typecheck": "tsc -p .",
    "clinic:staff": "tsx --env-file-if-exists=.env src/clinic-staff.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@pavhelp/core": "*",
    "fastify": "^5.12.5",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.0"
  }
}
