{
  "name": "pavhelp",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev:api": "npm run dev -w @pavhelp/api",
    "dev:web": "npm run dev -w @pavhelp/web",
    "migrate": "npm run migrate -w @pavhelp/api",
    "seed": "npm run seed -w @pavhelp/api",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "@types/node": "^22"
  }
}
