# Скопируйте в .env и заполните
DATABASE_URL=postgres://krovinka:krovinka@localhost:5432/krovinka
PORT=4000
# Адрес веб-приложения: туда возвращаем после входа через Яндекс
APP_URL=http://localhost:3000
# Случайная строка не короче 32 символов: подпись cookie
COOKIE_SECRET=change-me-change-me-change-me-change-me
# Вход через Яндекс ID (oauth.yandex.ru)
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://localhost:3000/api/auth/yandex/callback
# Telegram: вход через виджет и рассылка SOS ботом
TELEGRAM_BOT_TOKEN=
# Отправка СМС: log — код пишется в лог сервера (только для разработки)
SMS_PROVIDER=log
# 1 — расширять радиус рассылки SOS волнами в фоне
RUN_WORKER=1
